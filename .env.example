# D3m0n package template; never commit a populated .env.
# Copy this to .env and fill in your values

# Safe network defaults. Keep the bind on loopback unless LAN access is an
# explicit, password-protected operator choice. Origins are exact URLs only;
# HTTP is limited to localhost/RFC1918 and public origins must be HTTPS.
D3M0N_BIND_HOST=127.0.0.1
D3M0N_API_PORT=5055
D3M0N_ALLOWED_ORIGINS=http://127.0.0.1:5055,http://localhost:5055
# Optional advertised HTTPS origin; never put credentials in a URL.
D3M0N_PUBLIC_ORIGIN=
# Per-user runtime state; leave empty to use LOCALAPPDATA on Windows or
# XDG_STATE_HOME (then ~/.local/state) on Linux. Never point this at the repo.
D3M0N_STATE_DIR=
D3M0N_DASHBOARD_AUTH_FILE=
D3M0N_FLEET_STATE=
D3M0N_AI_SETTINGS_STATE_DIR=

# Device (ADB serial — leave empty to auto-detect first connected device)
DEFAULT_DEVICE=

# AI / LLM (at least one required for Agent Chat and Skill Creator)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Admin token — required by /api/skills/install (and any other endpoint that
# executes code / installs packages).  Set this to a strong random secret
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`) and
# send it as the `X-Ghost-Admin-Token` header (or `Authorization: Bearer …`).
# If unset, /api/skills/install refuses to run — the previous default let any
# caller on the network drive-by-install a Python package on the host.
GITD_ADMIN_TOKEN=

# Observability — Langfuse (optional; leave empty to disable)
# Self-hosted: docker compose -f docker-compose.langfuse.yml up -d, then
#   open http://localhost:3000 → sign up → create project → paste keys.
# Cloud: sign up at https://cloud.langfuse.com (free tier).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
